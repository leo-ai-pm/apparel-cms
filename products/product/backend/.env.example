# 穿搭智能体直达知需的服务端密钥；与穿搭端 PRODUCT_SIGNAL_KEY 相同。
OUTFIT_SIGNAL_KEY=
# 本 Agent 服务端口
APP_PORT=8002

# 本地任务状态库位置
DB_PATH=./data/product_agent.db

# DeepSeek 密钥只放在后端 .env，切勿写入前端或提交到 Git
DEEPSEEK_API_KEY=
# 官方当前提供的快速模型；可按账号可用模型调整
DEEPSEEK_MODEL=deepseek-flash

# 可选：公开资料检索。未配置时工作台会显示“待配置”，不会假装联网检索。
TAVILY_API_KEY=
# 可选：补充一份本机知识文档；不配置时使用仓库内的流程文档。
PRODUCT_KNOWLEDGE_DOC=
