PERSONAL_PREVIEW_ADMIN_COEXIST=1
ADMIN_CONTEXT_MODE=1
PERSONAL_PREVIEW_PUBLIC_ORIGIN=http://localhost:3010
ADMIN_PUBLIC_ORIGIN=http://localhost:3010
