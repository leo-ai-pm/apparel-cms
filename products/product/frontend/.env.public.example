# Build-time public prefix. Runtime real secrets/configuration stay in private generated JSON.
NEXT_PUBLIC_BASE_PATH=/v2/product
# Ordinary/local behavior remains the repository default; explicit public deployment opts in.
WORKBENCH_DEMO_ACCESS=false
WORKBENCH_DEMO_ACCESS_MODE=public
WORKBENCH_DEMO_PUBLIC_ORIGIN=https://s357brv8j8f9gdhvbu9a9.apigateway-cn-beijing.volceapi.com
# Configure actual WORKBENCH_* paths/credentials with scripts/configure-public-demo.mjs.
# Never put real token, session secret, account hash or private database in this file.
NEXT_TELEMETRY_DISABLED=1
