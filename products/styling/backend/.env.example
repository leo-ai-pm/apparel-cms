# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会进仓库）
# 本机演示访问默认关闭；显式开启时仍需精确本机Origin与签名配置。
# 无模型Key快速启动见 PORTABLE_DEMO.md；脚本自动建立新的私有运行目录。
STYLING_DEMO_ACCESS_ENABLED=0
STYLING_FIXED_OFFLINE_DEMO=0
# DeepSeek API Key（必填，验收前提供即可；不填则 mock 测试可跑，真实冒烟待验）
DEEPSEEK_API_KEY=

# DeepSeek 接口地址（默认官方）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名（默认 deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat

# 单次模型调用超时（秒）
LLM_TIMEOUT=30

# 失败重试次数（不含首次）
LLM_RETRIES=2

# Agent 单轮最多工具调用步数
MAX_AGENT_STEPS=6

# 成本保护：每日调用上限 / 最大并发
DAILY_CALL_LIMIT=200
MAX_CONCURRENCY=5

# 服务端口
PORT=8000

# 数据库（默认本地 SQLite，路径 backend/data/app.db）
# DATABASE_URL=sqlite:///data/app.db

# —— RunningHub 图片模型（VTO 换装 + 商品白底图）——
# API Key：https://www.runninghub.cn/enterprise-api/sharedApi
RUNNINGHUB_API_KEY=

# RunningHub 接口地址（默认官方）
RUNNINGHUB_BASE_URL=https://www.runninghub.cn

# VTO 换装工作流 ID（RunningHub AI 应用「一键换装」）
RUNNINGHUB_VTO_WEBAPP_ID=2012848202482978818

# 图片模型调用超时（秒）/ 任务轮询间隔（秒）/ 轮询最长等待（秒）
RUNNINGHUB_TIMEOUT=60
RUNNINGHUB_POLL_INTERVAL=5
RUNNINGHUB_POLL_MAX_SECONDS=600

# 用户照片上传上限（字节，默认 5MB；PRD 第 6 节最小化使用）
PHOTO_MAX_BYTES=5242880

# —— 土豆API 图片模型（试穿出图，Gemini 图像编辑）——
# API Key：在土豆API 后台获取
TUDOU_API_KEY=

# 土豆API 接口地址（默认）
TUDOU_BASE_URL=https://api.ai-tudou.net

# 出图模型（Gemini 图像编辑）
TUDOU_MODEL=gemini-3-pro-image-preview

# 出图调用超时（秒）
TUDOU_TIMEOUT=120

# 出图失败重试次数（不含首次，网络/服务端瞬态错误时重试）
TUDOU_RETRIES=2

# —— CMS 管理系统（需求信号上传，PRD v1.3 第 12.7 节）——
# CMS 服务地址（本地联调如 http://127.0.0.1:8020；线上用 CMS 公网网关地址）
CMS_BASE_URL=

# CMS 侧创建的、绑定 source_agent=outfit 的 API Key（在 CMS 管理后台 API Key 管理创建）
CMS_API_KEY=

# 上传重试次数（不含首次）/ 单次超时（秒）
CMS_SIGNAL_RETRIES=3
CMS_TIMEOUT=10

# —— 穿搭独立管理后台（不配置则关闭；不可使用演示默认密码）——
# 管理员密码至少12字符，签名密钥至少32字符；仅存服务端。
STYLING_ADMIN_PASSWORD=
STYLING_ADMIN_SECRET=
# HTTPS部署保持1，仅本机HTTP预览设0。
STYLING_ADMIN_COOKIE_SECURE=1
# 新版v1.4接收地址和Bearer密钥，需伙伴实现匹配回执；不要填旧CMS /api/signals。
STYLING_DEMAND_RECEIVER_URL=
STYLING_DEMAND_RECEIVER_KEY=

# PRD v1.6 D3新增撤回/恢复规则，业务口径待确认，默认关闭。
# 仅在负责人确认并完成对应验收后设置为1；不要因PRD版本变化自动启用。
STYLING_DEMAND_D3_ENABLED=0
# 伙伴正式确认的回执能力（逗号分隔，如revision,payload_digest）。
# 未确认保持空；配置能力后缺字段或不匹配回执均不能记已接收。
STYLING_DEMAND_RECEIVER_RECEIPT_CAPABILITIES=

# consumer_profile_v1：资料身份独立于管理Cookie/会话；详见PROFILE-BE交付
CONSUMER_APP_SCOPE=personalized_styling
CONSUMER_ALLOWED_ORIGINS=http://127.0.0.1:3026,http://localhost:3026
STYLING_PROFILE_PREPARE_TTL_SECONDS=86400

# Explicit HTTPS public demo behind loopback BFF; defaults retain local/normal policy.
STYLING_DEMO_ACCESS_MODE=local
STYLING_PUBLIC_DEMO_SUBJECT=
STYLING_PUBLIC_DEMO_SCOPE=
STYLING_PUBLIC_DEMO_INSTANCE_ID=
# Blank is equivalent to unset only if omitted; set 0/1 explicitly or remove this line.
# CONSUMER_COOKIE_SECURE=1
