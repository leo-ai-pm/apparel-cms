# Default: normal authentication. Local role demo is opt-in and never enabled by a PUBLIC flag.
WORKBENCH_DEMO_ACCESS=false
# Generate actual private configuration once with scripts/init-local-demo.mjs.
# These are locations, not passwords or tokens; keep all real files outside the repository.
# WORKBENCH_CONFIG_FILE=/absolute/private/product-agent-demo/next-config.json
# WORKBENCH_USERS_DB=/absolute/private/product-agent-demo/users.sqlite
# WORKBENCH_CASES_DB=/absolute/private/product-agent-demo/cases.sqlite
# WORKBENCH_REASONING_DB=/absolute/private/product-agent-demo/reasoning.sqlite
# WORKBENCH_DEMO_SESSIONS_DB=/absolute/private/product-agent-demo/demo-access.sqlite
NEXT_TELEMETRY_DISABLED=1
